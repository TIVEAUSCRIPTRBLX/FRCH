        local best, bd
        for _, e in ipairs(items) do
            if e.pos and me then
                local d = (e.pos - me).Magnitude
                if not bd or d < bd then best, bd = e, d end
            end
        end
        if best then tpTo(best.pos, best.name) else notify("Aucun appel avec une position", "bad") end
    end, true)

    local callESP = {}
    local function clearCallESP()
        for _, o in pairs(callESP) do
            pcall(function() o.hl:Destroy() end)
            pcall(function() o.bb:Destroy() end)
        end
        callESP = {}
    end
    local function refreshCallESP()
        if not S.callEsp then return end
        clearCallESP()
        local f = workspace:FindFirstChild("ActiveCalls")
        if not f then return end
        local r = root()
        for _, c in ipairs(f:GetChildren()) do
            local part = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local dist = r and math.floor((part.Position - r.Position).Magnitude) or 0
                local hl = new("Highlight", { Adornee = c, FillColor = Color3.fromRGB(255, 60, 60), FillTransparency = 0.5,
                    OutlineColor = WHITE, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, espFolder)
                local bb = new("BillboardGui", { Adornee = part, Size = UDim2.fromOffset(220, 24),
                    StudsOffset = Vector3.new(0, 5, 0), AlwaysOnTop = true, MaxDistance = 8000 }, espFolder)
                new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                    Text = "📞 " .. c.Name .. "  " .. dist .. "m", TextColor3 = WHITE, TextStrokeTransparency = 0.2,
                    Font = Enum.Font.GothamBold, TextSize = 13 }, bb)
                callESP[c] = { hl = hl, bb = bb }
            end
        end
    end
    Toggle(pM, "ESP des appels actifs", function(v)
        S.callEsp = v
        if v then task.spawn(refreshCallESP) else clearCallESP() end
    end)
    Toggle(pM, "Notifier les nouveaux appels", function(v) S.callNotify = v end)
    Toggle(pM, "Auto-TP au nouvel appel", function(v) S.callAutoTp = v end)
    task.spawn(function()
        while alive do
            if S.callEsp then pcall(refreshCallESP) end
            task.wait(3)
        end
    end)
    do
        local calls = workspace:FindFirstChild("ActiveCalls")
        if calls then
            addConn(calls.ChildAdded:Connect(function(c)
                if not (S.callNotify or S.callAutoTp) then return end
                task.wait(0.4)
                local pos = pivotPos(c)
                local r = root()
                local dist = (pos and r) and math.floor((pos - r.Position).Magnitude) or nil
                if S.callNotify then
                    notify("📞 Nouvel appel : " .. c.Name .. (dist and (" (" .. dist .. " m)") or ""), "good")
                end
                if S.callAutoTp and pos then tpTo(pos, c.Name) end
            end))
        end
    end
    Button(pM, "📋 Copier le détail des appels (pour l'analyse)", function()
        local lines = {}
        local f = workspace:FindFirstChild("ActiveCalls")
        lines[#lines + 1] = "== workspace.ActiveCalls =="
        if f then
            for _, c in ipairs(f:GetChildren()) do describe(c, 0, lines) end
        else
            lines[#lines + 1] = "(introuvable)"
        end
        local cs = ReplicatedStorage:FindFirstChild("CallSettings")
        lines[#lines + 1] = "== ReplicatedStorage.CallSettings =="
        if cs then describe(cs, 0, lines) end
        local text = table.concat(lines, "\n")
        if copyText(text) then
            notify("📋 Détail copié (" .. #lines .. " lignes)", "good")
        else
            lastCode.Text = text
            notify("Copie impossible : texte placé dans le champ « Texte à copier » (Outils d'analyse)", "bad")
        end
    end)

    -- ---------- Véhicules ----------
    folderList(pM, "Véhicules sortis (clic = monter)", childItems("Vehicles"), sitInto)
    folderList(pM, "Hélicoptères (clic = monter)", heliItems, sitInto)

    -- ---------- Lieux ----------
    folderList(pM, "Points d'apparition (Spawns)", childItems("Spawns"))
    folderList(pM, "Zones de véhicules (VehicleSpawns)", childItems("VehicleSpawns"))
    local refuelItems = childItems("RefuelBricks")
    folderList(pM, "Stations carburant (RefuelBricks)", refuelItems)
    local function nearestRefuel()
        local me = root() and root().Position
        local best, bd
        for _, e in ipairs(refuelItems()) do
            if e.pos and me then
                local d = (e.pos - me).Magnitude
                if not bd or d < bd then best, bd = e, d end
            end
        end
        return best
    end
    Button(pM, "⛽ TP à la station carburant la plus proche", function()
        local e = nearestRefuel()
        if e then tpTo(e.pos, e.name) else notify("Aucune station trouvée", "bad") end
    end, true)
    Button(pM, "⛽ Amener mon véhicule à la station la plus proche", function()
        local h = hum()
        local seat = h and h.SeatPart
        if not seat then notify("Monte dans un véhicule d'abord", "bad") return end
        local e = nearestRefuel()
        if not (e and e.pos) then notify("Aucune station trouvée", "bad") return end
        seat.AssemblyLinearVelocity = Vector3.zero
        seat.AssemblyAngularVelocity = Vector3.zero
        seat.CFrame = CFrame.new(e.pos + Vector3.new(0, 4, 0)) * (seat.CFrame - seat.CFrame.Position)
        notify("⛽ Véhicule amené à la station", "good")
    end)
end

