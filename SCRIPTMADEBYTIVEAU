-- =====================================================================
local function giveAll()
    local bp = LP:FindFirstChildOfClass("Backpack")
    if not bp then notify("Backpack introuvable", "bad") return end
    local seen, count = {}, 0
    for _, t in ipairs(bp:GetChildren()) do seen[t.Name] = true end
    if char() then
        for _, t in ipairs(char():GetChildren()) do if t:IsA("Tool") then seen[t.Name] = true end end
    end
    local function try(o)
        if o:IsA("Tool") and not seen[o.Name] then
            seen[o.Name] = true
            local ok = pcall(function() o:Clone().Parent = bp end)
            if ok then count += 1 end
        end
    end
    for _, src in ipairs({ StarterPack, ReplicatedStorage, Lighting, workspace }) do
        for _, d in ipairs(src:GetDescendants()) do try(d) end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local pbp = p:FindFirstChildOfClass("Backpack")
            if pbp then for _, t in ipairs(pbp:GetChildren()) do try(t) end end
            if p.Character then for _, t in ipairs(p.Character:GetChildren()) do try(t) end end
        end
    end
    notify("🎁 " .. count .. " outil(s) ajouté(s) (côté client)", count > 0 and "good" or "bad")
end

