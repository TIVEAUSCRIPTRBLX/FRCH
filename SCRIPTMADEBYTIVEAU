                TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
            new("TextLabel", { Size = UDim2.new(1, -150, 0, 14), Position = UDim2.fromOffset(42, 20),
                BackgroundTransparency = 1, Text = e.online and "● dans ce serveur" or "○ hors serveur (sauvegardé)",
                TextColor3 = e.online and T.good or T.sub, Font = Enum.Font.GothamMedium, TextSize = 11,
