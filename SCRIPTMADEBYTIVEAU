    local function describe(inst, depth, lines)
        if #lines > 180 then return end
        local line = string.rep("  ", depth) .. inst.ClassName .. " : " .. inst.Name
        if inst:IsA("ValueBase") then line = line .. " = " .. tostring(inst.Value) end
        for k, v in pairs(inst:GetAttributes()) do line = line .. " [" .. tostring(k) .. "=" .. tostring(v) .. "]" end
        lines[#lines + 1] = line
        if depth < 3 then
            for _, c in ipairs(inst:GetChildren()) do describe(c, depth + 1, lines) end
        end
    end

