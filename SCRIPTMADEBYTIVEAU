    -- ---------- Scanner de la map ----------
    local function inPlayerCharacter(inst)
        local cur = inst
        while cur and cur ~= workspace do
            if Players:GetPlayerFromCharacter(cur) then return true end
            cur = cur.Parent
        end
        return false
    end

    local function scanMap(keywords, limit)
        local kws = {}
        for _, k in ipairs(keywords) do
            local k2 = tostring(k):lower()
            k2 = (k2:gsub("^%s+", ""))
            k2 = (k2:gsub("%s+$", ""))
            if k2 ~= "" then kws[#kws + 1] = k2 end
        end
        if #kws == 0 then return {} end
        local r = root()
        local me = r and r.Position or Vector3.zero
        local matches, models, i = {}, {}, 0
        for _, d in ipairs(workspace:GetDescendants()) do
            i += 1
            if i % 6000 == 0 then task.wait() end
            if d:IsA("Model") or d:IsA("BasePart") then
                local name = d.Name:lower()
                for _, k in ipairs(kws) do
                    if name:find(k, 1, true) then
                        matches[#matches + 1] = d
                        if d:IsA("Model") then models[d] = true end
                        break
                    end
                end
            end
        end
        local out = {}
        for _, d in ipairs(matches) do
            local skip = inPlayerCharacter(d)
            if not skip then
                local cur = d.Parent
                while cur and cur ~= workspace do
                    if models[cur] then skip = true break end
                    cur = cur.Parent
                end
            end
            if not skip then
                local ok, cf = pcall(function() return d:GetPivot() end)
                if ok and cf then
                    out[#out + 1] = { inst = d, name = d.Name, pos = cf.Position, dist = (cf.Position - me).Magnitude }
                end
            end
        end
        table.sort(out, function(a, b) return a.dist < b.dist end)
        while #out > (limit or 40) do table.remove(out) end
        return out
