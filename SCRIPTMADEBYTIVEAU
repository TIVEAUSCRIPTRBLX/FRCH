    -- ---------- Enregistreur d'actions (macros) ----------
    do
        Section(pCH, "Enregistreur d'actions (macros)")
        Info(pCH, "Active-le, fais l'action dans le jeu (changer d'équipe, sortir un véhicule...), puis rejoue-la ici en un clic.")
        local captured, keys, capCount = {}, {}, 0
        local ignoreSet = {}
        local function rebuildIgnore(txt)
            ignoreSet = {}
            for k in tostring(txt):gmatch("[^,]+") do
                local k2 = (k:gsub("^%s+", ""))
                k2 = (k2:gsub("%s+$", ""))
                if k2 ~= "" then ignoreSet[k2:lower()] = true end
            end
        end
        local defaultIgnore = "HeadRot,Stance,GunStance,Step,Whizz,SoundUpdate,SVLaser,SVFlash,RepAmmo,Engine,UpdateStats,LocationEvent,ELSEvent,HealthEvent"
        rebuildIgnore(defaultIgnore)
        Input(pCH, "Ignorer (virgules)", defaultIgnore, function(t) rebuildIgnore(t) end)

        local hooked = false
        local function installHook()
            if hooked then return true end
            if not (hookmetamethod and getnamecallmethod) then return false end
            local wrap = newcclosure or function(f) return f end
            local ok = pcall(function()
                local old
                old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
                    local m = getnamecallmethod()
                    if S.logOn and (m == "FireServer" or m == "InvokeServer") then
                        local args = table.pack(...)
                        local res = table.pack(old(self, ...))
                        pcall(function()
                            if ignoreSet[self.Name:lower()] then return end
                            local parts = {}
                            for i = 1, math.min(args.n, 6) do
                                local a = args[i]
                                local t = typeof(a)
                                if t == "string" then
                                    parts[#parts + 1] = '"' .. a:sub(1, 40) .. '"'
                                elseif t == "Instance" then
                                    parts[#parts + 1] = a:GetFullName()
                                elseif t == "table" then
                                    parts[#parts + 1] = "{table}"
                                else
                                    parts[#parts + 1] = tostring(a)
                                end
                            end
                            local verb = (m == "FireServer") and "Fire" or "Invoke"
                            local label = verb .. " " .. self.Name .. " (" .. table.concat(parts, ", ") .. ")"
                            if not keys[label] then
                                keys[label] = true
                                capCount += 1
                                captured[#captured + 1] = { remote = self, method = m, args = args, label = label }
                                if #captured > 40 then
                                    local first = table.remove(captured, 1)
                                    keys[first.label] = nil
                                end
                            end
                        end)
                        return table.unpack(res, 1, res.n)
                    end
                    return old(self, ...)
                end))
            end)
            hooked = ok
            return ok
        end

        local logToggle
        logToggle = Toggle(pCH, "Enregistreur d'actions actif", function(v)
            if v and not installHook() then
                S.logOn = false
                notify("Ton executor ne supporte pas hookmetamethod", "bad")
                task.defer(function() logToggle.Set(false, true) end)
                return
            end
            S.logOn = v
            if v then notify("Enregistreur actif : fais l'action dans le jeu") end
        end)

        local listBox = new("Frame", { Size = UDim2.new(1, 0, 0, 180), BackgroundColor3 = T.card, LayoutOrder = nextOrder() }, pCH)
        corner(listBox, 8)
        stroke(listBox, T.stroke, 1, 0.3)
        local scroll = new("ScrollingFrame", { Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4),
            BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.accent,
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, listBox)
        new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

        local function renderCaptured()
            for _, c in ipairs(scroll:GetChildren()) do
                if c:IsA("Frame") then c:Destroy() end
            end
            if #captured == 0 then
                local row = new("Frame", { Size = UDim2.new(1, -6, 0, 30), BackgroundTransparency = 1, LayoutOrder = 1 }, scroll)
                new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "Rien capturé pour l'instant",
                    TextColor3 = T.sub, Font = Enum.Font.GothamMedium, TextSize = 13 }, row)
                return
            end
            for i = #captured, 1, -1 do
                local e = captured[i]
                local row = new("Frame", { Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = T.bg,
                    LayoutOrder = #captured - i + 1 }, scroll)
                corner(row, 6)
                new("TextLabel", { Size = UDim2.new(1, -100, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1,
                    Text = e.label, TextColor3 = T.text, Font = Enum.Font.GothamMedium, TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
                new("TextLabel", { Size = UDim2.fromOffset(86, 34), Position = UDim2.new(1, -92, 0, 0), BackgroundTransparency = 1,
                    Text = "▶ Rejouer", TextColor3 = T.accent, Font = Enum.Font.GothamBold, TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Right }, row)
                local btn = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, row)
                btn.MouseButton1Click:Connect(function()
                    local ok, err = pcall(function()
                        if e.method == "InvokeServer" then
                            e.remote:InvokeServer(table.unpack(e.args, 1, e.args.n))
                        else
                            e.remote:FireServer(table.unpack(e.args, 1, e.args.n))
                        end
                    end)
                    if ok then
                        notify("🔁 Rejoué : " .. e.remote.Name, "good")
                    else
                        notify("Erreur : " .. tostring(err), "bad")
                    end
                end)
            end
        end
        renderCaptured()

        local shown = -1
        task.spawn(function()
            while alive do
                if S.logOn and capCount ~= shown then
                    shown = capCount
                    pcall(renderCaptured)
                end
                task.wait(1.5)
            end
        end)

        Button(pCH, "🔄 Actualiser la liste", renderCaptured)
        Button(pCH, "📋 Copier les actions capturées (pour me les envoyer)", function()
            if #captured == 0 then notify("Rien à copier : active l'enregistreur et fais l'action", "bad") return end
            local lines = {}
