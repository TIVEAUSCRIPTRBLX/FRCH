end
local function isTarget(uid)
    for _, t in ipairs(Config.targets) do if t.id == uid then return true end end
    return false
end
local function setTarget(uid, name, on)
    if on then
        if not isTarget(uid) then table.insert(Config.targets, { id = uid, name = name }) end
    else
        for i = #Config.targets, 1, -1 do
            if Config.targets[i].id == uid then table.remove(Config.targets, i) end
        end
    end
    saveConfig()
    refreshAllLists()
end
local function onlineTargets()
    local r = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and isTarget(p.UserId) then table.insert(r, p) end
    end
    return r
end
local targetIdx = 1
local function getTarget()
    local list = onlineTargets()
    if #list == 0 then return nil end
    targetIdx = ((targetIdx - 1) % #list) + 1
    return list[targetIdx]
end
local function targetRoot(p)
    return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end

