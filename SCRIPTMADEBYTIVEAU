                notify("📋 " .. #captured .. " action(s) copiée(s)", "good")
            else
                lastCode.Text = text
                notify("Copie impossible : texte placé dans le champ « Texte à copier » (Outils d'analyse)", "bad")
            end
        end, true)
        Button(pCH, "🗑 Vider la liste", function()
            captured, keys = {}, {}
            renderCaptured()
        end)
    end
